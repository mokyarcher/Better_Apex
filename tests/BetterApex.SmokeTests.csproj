<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>..\BetterApex\app.manifest</ApplicationManifest>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\.local\packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BetterApex\BetterApex.csproj" />
  </ItemGroup>
</Project>
