<Window x:Class="BetterApex.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better Apex · 自动记录" Width="1120" Height="820" MinWidth="850" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#0E1420" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="自动记录对局" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="进入对局后采集昵称，到结算时自动识别并保存战绩。" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox x:Name="TargetWindows" Width="370" Height="42" Margin="0,0,10,8"
                      FontSize="13" Foreground="#142033" VerticalContentAlignment="Center"
                      SelectionChanged="TargetChanged" AutomationProperties.Name="目标游戏窗口">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLabel}" Foreground="#142033" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="RefreshWindowsButton" Content="刷新窗口" Background="#263246" Margin="0,0,10,8" Click="RefreshWindows_Click"/>
            <Button x:Name="AutoRecordButton" Content="开始自动记录" Margin="0,0,10,8" Click="AutoRecord_Click"/>
            <Button x:Name="StartCaptureButton" Content="仅预览" Background="#263246" Margin="0,0,10,8" Click="StartCapture_Click"/>
            <Button x:Name="StopCaptureButton" Content="停止采集" Background="#263246" Margin="0,0,0,8" Click="StopCapture_Click" IsEnabled="False"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <CheckBox x:Name="WindowCompatibility" Content="窗口后台兼容模式" IsChecked="False" FontSize="13" Margin="0,0,16,0"
                          Foreground="{StaticResource TextPrimary}" Checked="CaptureMode_Changed" Unchecked="CaptureMode_Changed"/>
                <CheckBox x:Name="HideCaptureBorder" Content="隐藏采集黄框" IsChecked="True" FontSize="13"
                          Visibility="Collapsed"
                          Foreground="{StaticResource TextPrimary}" Checked="HideBorder_Changed" Unchecked="HideBorder_Changed"/>
                <TextBlock x:Name="BorderStatusText" Text="默认 DXGI 无黄框 · 每 2 秒最多 1 次常规截屏 · 切出游戏暂停"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="600"/>
            </StackPanel>
        </WrapPanel>
        <Border Grid.Row="2" Background="#1C2B30" CornerRadius="7" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AutoPhaseText" Text="自动记录：未启动" FontSize="15" Foreground="#99D4B9"/>
                    <TextBlock x:Name="AutoRosterText" Text="本场名单：未采集" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AutoSavedText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AutoErrorText" FontSize="12" Foreground="#FFAD9F" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="NextRoundButton" Content="新一局" Background="#263246" Margin="10,0,10,0" Click="NextRound_Click" IsEnabled="False"/>
                    <Button Content="查看战绩" Background="#263246" Click="AutoHistory_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="#151E2D" CornerRadius="10" BorderBrush="#2B374A" BorderThickness="1" Padding="14">
            <Grid>
                <Image x:Name="CapturePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border x:Name="WaitingOverlay" Background="#DE151E2D" Padding="20" CornerRadius="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650">
                    <TextBlock x:Name="PreviewPlaceholder" Text="尚未开始采集" TextWrapping="Wrap" FontSize="17" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock x:Name="CaptureStatusText" Text="请选择正在运行的游戏窗口。" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock x:Name="CaptureDetailsText" Text="开始自动记录后可切回游戏；战绩保存在本机，支持历史查看。"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="CaptureErrorText" Foreground="#FFAD9F" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="SaveCaptureButton" Grid.Column="1" Content="保存当前截图" Background="#326B63" VerticalAlignment="Top"
                    Click="SaveCapture_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
