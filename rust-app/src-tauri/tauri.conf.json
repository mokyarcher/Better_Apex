{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Apex",
  "version": "0.2.0",
  "identifier": "local.betterapex.rustlab",
  "build": {
    "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Better Apex", "width": 1180, "height": 820, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "resources": { "resources/": "resources/" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installMode": "currentUser", "languages": ["SimpChinese"] } }
  }
}
